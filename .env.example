# ============ LLM 配置 ============
# 任意支持工具调用的 OpenAI 兼容接口均可；以下使用 DeepSeek Flash
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048

# 设为 true 可禁用真实模型调用；不会降级为离线规则
USE_MOCK_LLM=false

# ============ 控制面（元数据 / 任务 / 报告 / 指标 / 审计）============
# json      = 本地文件，零依赖，测试和单机演示默认
# postgres  = 生产模式，需要下面填 DSN
REPOSITORY_BACKEND=json
POSTGRES_DSN=
POSTGRES_SCHEMA=public
POSTGRES_POOL_SIZE=5

# ============ 身份 ============
# true 时仅允许 API_KEYS 中配置的密钥；留空将拒绝启动
REQUIRE_API_KEY=false
# 多个授权 Key 以逗号分隔；请使用随机生成的高强度密钥
API_KEYS=
# 前端/演示用的默认 Key；未配置 API_KEYS 时也可作为唯一授权 Key
API_KEY=

# ============ 功能开关 ============
# 指标语义层：Prompt 注入 + 事后口径校验
METRICS_ENABLED=true
# 查询审计：每次分析写一条 query_logs
AUDIT_ENABLED=true
# few-shot 示例库（默认关闭：mock 下无法验证收益，且与另一个 RAG 项目重叠）
FEW_SHOT_ENABLED=false

# ============ Agent 执行约束 ============
# 单条查询超时（秒）
SQL_TIMEOUT_SECONDS=15
# 单次查询返回的最大行数（同时作为 LIMIT 上限强制注入）
MAX_RESULT_ROWS=500
# 自主工具模式每轮预算，SQL 次数包含校验失败；时间预算不是进程级强制超时
AGENT_MAX_TOOL_CALLS=10
AGENT_MAX_SQL_CALLS=4
AGENT_MAX_MODEL_CALLS=8
AGENT_TIMEOUT_SECONDS=150

# ============ 存储 ============
# 数据面（DuckDB 文件）与任务产物的存放目录；元信息在控制面
# STORAGE_DIR=./storage
MAX_UPLOAD_MB=50
