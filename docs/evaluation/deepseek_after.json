      "sql": "WITH product_sales AS (\n  SELECT product, SUM(amount) AS total_sales\n  FROM demo_sales\n  GROUP BY product\n),\nstats AS (\n  SELECT AVG(total_sales) AS avg_sales FROM product_sales\n)\nSELECT\n  p.product,\n  ROUND(p.total_sales, 2) AS total_sales,\n  ROUND(p.total_sales - s.avg_sales, 2) AS diff_vs_avg,\n  ROUND((p.total_sales - s.avg_sales) / s.avg_sales * 100, 2) AS diff_pct\nFROM product_sales p\nCROSS JOIN stats s\nWHERE p.total_sales > s.avg_sales\nORDER BY total_sales DESC",
